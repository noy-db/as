{
  "name": "@noy-db/as-ndjson",
  "version": "0.8.0-pre.0",
  "description": "Newline-delimited JSON export for noy-db — streaming plaintext export suitable for data pipelines, warehouse ingestion, and jq pipelines. Gated by `vault.assertCanExport('plaintext', …)`. Part of the @noy-db/as-* portable-artefact family (plaintext tier).",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/as/tree/main/as-ndjson#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/as.git",
    "directory": "as-ndjson"
  },
  "bugs": {
    "url": "https://github.com/noy-db/as/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.7.0 || ^0.7.1-pre.0 || ^0.8.0-pre.0"
  },
  "devDependencies": {
    "@noy-db/hub": "0.8.0-pre.0",
    "@noy-db/test-format-conformance": "0.8.0-pre.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^18.0.0"
  },
  "keywords": [
    "noy-db",
    "as-ndjson",
    "ndjson",
    "streaming",
    "export",
    "plaintext",
    "zero-knowledge"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
