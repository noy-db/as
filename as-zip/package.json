{
  "name": "@noy-db/as-zip",
  "version": "0.8.0",
  "description": "Composite record + blob archive export for noy-db \u2014 bundles a collection's records plus every attached blob into one zip. Zero dependencies (STORE-only zip encoder). Gated by the RFC #249 `assertCanExport('plaintext', \u2026)` gate with format `'zip'`. Part of the @noy-db/as-* portable-artefact family.",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/as/tree/main/as-zip#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/as.git",
    "directory": "as-zip"
  },
  "bugs": {
    "url": "https://github.com/noy-db/as/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "interop:fixtures": "node scripts/interop-fixtures.mjs"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.7.0 || ^0.7.1-pre.0 || ^0.8.0-pre.0 || ^0.9.0-pre.1"
  },
  "devDependencies": {
    "@noy-db/hub": "0.9.0-pre.1",
    "@noy-db/ports": "0.9.0-pre.1",
    "@noy-db/to-memory": "0.8.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^18.0.0"
  },
  "keywords": [
    "noy-db",
    "as-zip",
    "zip",
    "archive",
    "export",
    "plaintext",
    "zero-knowledge",
    "audit-trail"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {}
}
